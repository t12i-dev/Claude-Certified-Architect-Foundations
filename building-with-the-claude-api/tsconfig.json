{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib.ts",
    "tool-use/**/*.ts",
    "features/**/*.ts",
    "mcp-project/**/*.ts",
    "workflows/**/*.ts"
  ]
}
