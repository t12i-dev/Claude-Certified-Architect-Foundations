{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["*.ts", "tool-use/**/*.ts", "mcp-project/**/*.ts", "prompt-engineering/**/*.ts"],
  "exclude": ["node_modules", "venv"]
}
